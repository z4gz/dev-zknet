{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "zknet_core",
  "projectType": "library",
  "sourceRoot": "libs/rs-core/src",
  "tags": [],
  "namedInputs": {
    "rustSources": [
      "{projectRoot}/Cargo.toml",
      "{projectRoot}/src/**/*.rs",
      "{projectRoot}/tests/**/*.rs"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo check --locked -p zknet_core --all-targets"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo test --locked -p zknet_core"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo clippy --locked -p zknet_core --all-targets"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo fmt -p zknet_core"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo fmt -p zknet_core -- --check"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clean -p zknet_core"
      }
    }
  }
}
