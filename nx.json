{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"],
    "optModule": [
      "{workspaceRoot}/packages/opt/go.mod",
      "{workspaceRoot}/packages/opt/go.sum",
      "{workspaceRoot}/packages/opt/Makefile"
    ]
  }
}
