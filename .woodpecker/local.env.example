# Copy to .woodpecker/local.env (git-ignored) to set this machine's host cache
# directory for .woodpecker/run. An absolute path that outlives the container
# or VM the pipelines are started from. ZKNET_WOODPECKER_CACHE in the
# environment still wins over this file.
ZKNET_WOODPECKER_CACHE=/var/tmp/zknet-woodpecker
