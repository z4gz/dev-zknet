#!/bin/sh
# Run a .woodpecker pipeline locally: woodpecker-cli exec on the docker
# backend, with the host cache directory mounted at /cache in every step.
#
#   .woodpecker/run ci|dist|sign|PATH.yaml [woodpecker-cli exec flags...]
#
# Settings, each from the environment, else from .woodpecker/local.env
# (git-ignored):
#   ZKNET_WOODPECKER_CACHE    the host cache directory (default /var/tmp/zknet-woodpecker)
#   ZKNET_ASSET_KEY_FILE      sign: the minisign secret key that signs the clients' assets
#   ZKNET_WOODPECKER_SECRETS  a secrets file (woodpecker-cli --secrets-file) for
#                             any pipeline, e.g. the Tauri key for a tag build
#
# `sign` asks for the key's passphrase (or reads ZKNET_ASSET_SIGNING_PASSWORD)
# and hands both to the pipeline in a private secrets file, removed on exit.
#
# Build settings, from the environment, reach every step through
# .woodpecker/.run.env (git-ignored, removed on exit), since a docker-backend
# step never sees the host's environment (lib.sh sources it):
#   ZKNET_DIST_PLATFORMS      dist: the OSes to build for (default "linux windows darwin")
#   ZKNET_UPDATER_PUBKEY      dist, a release: the desktop updater's public key
#   ZKNET_UPDATER_ENDPOINT    dist, a release: the desktop updater's manifest URL
set -eu

here=$(cd "$(dirname "$0")" && pwd)
env_cache=${ZKNET_WOODPECKER_CACHE:-}
env_key=${ZKNET_ASSET_KEY_FILE:-}
env_secrets=${ZKNET_WOODPECKER_SECRETS:-}
if [ -f "$here/local.env" ]; then
  . "$here/local.env"
fi
cache=${env_cache:-${ZKNET_WOODPECKER_CACHE:-/var/tmp/zknet-woodpecker}}
key_file=${env_key:-${ZKNET_ASSET_KEY_FILE:-}}
secrets=${env_secrets:-${ZKNET_WOODPECKER_SECRETS:-}}
case $cache in
  /*) ;;
  *) echo "run: ZKNET_WOODPECKER_CACHE must be an absolute path: $cache" >&2; exit 1 ;;
esac
if [ -n "$secrets" ] && [ ! -f "$secrets" ]; then
  echo "run: no secrets file at ZKNET_WOODPECKER_SECRETS=$secrets" >&2
  exit 1
fi

pipeline=${1:?usage: .woodpecker/run ci|dist|sign|PATH.yaml [woodpecker-cli exec flags...]}
shift
name=$pipeline
case $pipeline in
  ci | dist | sign) pipeline=$here/$pipeline.yaml ;;
esac

secrets_flags=
if [ "$name" = sign ]; then
  [ -n "$key_file" ] || {
    echo "run: signing needs ZKNET_ASSET_KEY_FILE (the minisign secret key) in the environment or .woodpecker/local.env" >&2
    exit 1
  }
  [ -f "$key_file" ] || { echo "run: no key at ZKNET_ASSET_KEY_FILE=$key_file" >&2; exit 1; }
  if [ -z "${ZKNET_ASSET_SIGNING_PASSWORD+set}" ]; then
    (: </dev/tty) 2>/dev/null || {
      echo "run: no terminal to ask for the passphrase; set ZKNET_ASSET_SIGNING_PASSWORD" >&2
      exit 1
    }
    printf 'Passphrase for %s: ' "$key_file" >/dev/tty
    stty -echo </dev/tty
    trap 'stty echo </dev/tty' EXIT INT TERM
    IFS= read -r ZKNET_ASSET_SIGNING_PASSWORD </dev/tty || true
    stty echo </dev/tty
    trap - EXIT INT TERM
    printf '\n' >/dev/tty
  fi
  # a private secrets file: any static secrets, then the key and its passphrase
  # as YAML block scalars (WOODPECKER_SECRETS would mangle a ',' or '"')
  umask 077
  run_secrets=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zknet-sign.XXXXXX")
  trap 'rm -f "$run_secrets"' EXIT INT TERM
  {
    [ -z "$secrets" ] || cat "$secrets"
    printf 'zknet_asset_signing_key: |2-\n'
    sed 's/^/  /' "$key_file"
    printf 'zknet_asset_signing_password: |2-\n'
    printf '%s\n' "$ZKNET_ASSET_SIGNING_PASSWORD" | sed 's/^/  /'
  } >"$run_secrets"
  secrets_flags="--secrets-file $run_secrets"
elif [ -n "$secrets" ]; then
  secrets_flags="--secrets-file $secrets"
fi

# the build settings, as shell assignments for lib.sh
run_env=$here/.run.env
for v in ZKNET_DIST_PLATFORMS ZKNET_UPDATER_PUBKEY ZKNET_UPDATER_ENDPOINT; do
  eval "val=\${$v-}"
  # shellcheck disable=SC2154 # val is set by the eval
  [ -z "$val" ] || printf "%s='%s'\n" "$v" "$(printf '%s' "$val" | sed "s/'/'\\\\''/g")"
done >"$run_env"
trap 'rm -f "$run_env" ${run_secrets:+"$run_secrets"}' EXIT INT TERM

echo "run: cache $cache" >&2
cd "$here/.."
# shellcheck disable=SC2086 # secrets_flags is empty or one flag and a path without spaces
woodpecker-cli exec --local --backend-engine docker --volumes "$cache:/cache" $secrets_flags "$@" "$pipeline"
