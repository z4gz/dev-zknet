#!/bin/sh
# Run a .woodpecker pipeline locally: woodpecker-cli exec on the docker
# backend, with the host cache directory mounted at /cache in every step.
#
#   .woodpecker/run ci|dist|PATH.yaml [woodpecker-cli exec flags...]
#
# The host cache directory, first match wins:
#   1. ZKNET_WOODPECKER_CACHE in the environment
#   2. ZKNET_WOODPECKER_CACHE in .woodpecker/local.env (git-ignored)
#   3. /var/tmp/zknet-woodpecker
set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ -z "${ZKNET_WOODPECKER_CACHE:-}" ] && [ -f "$here/local.env" ]; then
  . "$here/local.env"
fi
cache=${ZKNET_WOODPECKER_CACHE:-/var/tmp/zknet-woodpecker}
case $cache in
  /*) ;;
  *) echo "run: ZKNET_WOODPECKER_CACHE must be an absolute path: $cache" >&2; exit 1 ;;
esac

pipeline=${1:?usage: .woodpecker/run ci|dist|PATH.yaml [woodpecker-cli exec flags...]}
shift
case $pipeline in
  ci | dist) pipeline=$here/$pipeline.yaml ;;
esac

echo "run: cache $cache" >&2
cd "$here/.."
exec woodpecker-cli exec --local --backend-engine docker --volumes "$cache:/cache" "$@" "$pipeline"
