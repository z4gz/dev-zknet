{
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "http-proxy",
  "projectType": "library",
  "implicitDependencies": ["opt-common"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "^default", "optModule"],
      "outputs": ["{projectRoot}/cmd/http_proxy/http_proxy"],
      "options": {
        "command": "make http_proxy",
        "cwd": "packages/opt"
      }
    }
  }
}
