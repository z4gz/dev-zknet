{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "customConditions": ["@zknet/source"],
    "noEmit": false,
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "out-tsc/ext",
    "tsBuildInfoFile": "out-tsc/ext/tsconfig.tsbuildinfo"
  },
  "exclude": ["node_modules", ".output", "out-tsc"],
  "references": [
    {
      "path": "../../packages/sdk"
    }
  ]
}
