{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "zknet_client_cli",
  "projectType": "application",
  "sourceRoot": "apps/client-cli/src",
  "tags": [],
  "implicitDependencies": ["zknet_core"],
  "namedInputs": {
    "rustSources": [
      "{projectRoot}/Cargo.toml",
      "{projectRoot}/src/**/*.rs",
      "{projectRoot}/assets/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "^rustSources", "cargoWorkspace"],
      "outputs": ["{workspaceRoot}/dist/target/debug/zknet_client_cli"],
      "options": {
        "command": "cargo build --locked --target-dir dist/target -p zknet_client_cli"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "^rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo test --locked --target-dir dist/target -p zknet_client_cli"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "^rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo clippy --locked --target-dir dist/target -p zknet_client_cli --all-targets"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo fmt -p zknet_client_cli"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources"],
      "options": {
        "command": "cargo fmt -p zknet_client_cli -- --check"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo run --locked --target-dir dist/target -p zknet_client_cli --"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clean --target-dir dist/target -p zknet_client_cli"
      }
    }
  }
}
