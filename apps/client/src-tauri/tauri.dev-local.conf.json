{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": [
        "default",
        "desktop-capability",
        {
          "identifier": "dev-local",
          "description": "Development only: local network assets and thin-mode WalletShield",
          "windows": ["main"],
          "permissions": [
            {
              "identifier": "http:default",
              "allow": [{ "url": "http://127.0.0.1:8765/*/client.toml" }]
            },
            {
              "identifier": "shell:allow-spawn",
              "allow": [
                {
                  "name": "walletshield-listen-thin",
                  "cmd": "walletshield",
                  "args": [
                    "-listen",
                    { "validator": "^(\\S*:\\d+)$" },
                    "-config",
                    "client.toml",
                    "-log_level",
                    { "validator": "^(DEBUG|INFO|WARN|ERROR)$" },
                    "-thin"
                  ],
                  "sidecar": false
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "plugins": {
    "zknet": {
      "urlNetwork": "http://127.0.0.1:8765",
      "walletshieldLogLevel": "DEBUG",
      "walletshieldThin": true
    }
  }
}
