{
  "name": "@zknet/client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist"]
    },
    "desktop-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm tauri dev",
        "cwd": "{projectRoot}"
      }
    },
    "desktop-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm tauri build",
        "cwd": "{projectRoot}"
      }
    }
  }
}
